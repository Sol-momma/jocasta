# Cloudflare Workers の静的アセットが返すヘッダー。書き方: https://developers.cloudflare.com/workers/static-assets/headers/
# 編集画面（/admin）だけに厳しめの CSP を付ける。中身の理由は docs/admin-security.md
/admin/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' blob: data: https://avatars.githubusercontent.com https://raw.githubusercontent.com; media-src blob:; frame-src blob:; connect-src 'self' blob: data: https://unpkg.com https://api.github.com https://www.githubstatus.com; manifest-src blob:; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
