{
  "name": "jocasta",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "deploy": "pnpm run build && node scripts/check-drafts.mjs && wrangler deploy",
    "check:drafts": "node scripts/check-drafts.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
