---
// 記事の目次。見出し(h2〜h4)から自動生成し、h2の下にh3、h3の下にh4を入れ子で並べる（小見出しは字下げ）。開閉状態は localStorage に保存（PC幅とスマホ幅で別々、スマホは既定で閉じる）。
import type { MarkdownHeading } from 'astro';
import TocList from './TocList.astro';
import { buildToc } from '../lib/toc';
interface Props { headings: MarkdownHeading[] }
const items = buildToc(Astro.props.headings);
---
{items.length > 0 && (
  <nav class="toc" aria-label="目次" data-open="false">
    <button class="toc__toggle" type="button" aria-expanded="false" aria-controls="toc-list">
      <svg class="toc__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
      <span>目次</span>
      <svg class="toc__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </button>
    <TocList nodes={items} id="toc-list" class="toc__list" />
  </nav>
)}
<style is:global>
  /* 参考: azukiazusa.dev の目次。「≡ 目次 ⌄」で開閉、項目は文字だけ、左に細い縦線、今読んでいる見出しは文字と縦線に色。
     スマホ・タブレット幅では本文の上に置き、PC 幅（1100px 以上）では本文の右の列に貼り付ける */
  .toc { margin:0 0 var(--gap); font-size:.85rem; line-height:1.6; }
  .toc__toggle { display:inline-flex; align-items:center; gap:.4em; min-height:44px; padding:0; font:inherit; color:var(--muted); background:none; border:0; cursor:pointer; }
  .toc__toggle:hover { color:var(--fg); }
  .toc svg { width:1.1em; height:1.1em; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
  .toc__chev { transition:transform .15s; }
  .toc[data-open="false"] .toc__chev { transform:rotate(-90deg); }
  .toc__list { display:none; list-style:none; margin:.2em 0 0 .45em; padding:0; border-left:1px solid var(--line); }
  .toc[data-open="true"] .toc__list { display:block; }
  .toc__sub { list-style:none; margin:0; padding:0; }
  .toc__list li { margin:0; }
  .toc__list a { display:block; margin-left:-1px; padding:.3em 0 .3em 1em; border-left:1px solid transparent; color:var(--muted); text-decoration:none; overflow-wrap:anywhere; }
  .toc__list a:visited { color:var(--muted); }
  .toc__list li.d3 > a { padding-left:1.9em; }
  .toc__list li.d4 > a { padding-left:2.8em; font-size:.95em; }
  .toc__list a:hover { color:var(--fg); text-decoration:none; }
  .toc__list a.is-active { color:var(--link); border-left-color:var(--link); }
  @media (min-width: 1100px) {
    .post-body > .toc { grid-column:2; grid-row:1; align-self:start; position:sticky; top:calc(var(--hdr) + var(--rpb) + 24px); max-width:15rem; margin:0; }
    .toc__list { max-height:calc(100vh - var(--hdr) - var(--rpb) - var(--ftr) - 120px); overflow:auto; }
  }
</style>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var nav = document.querySelector('.toc');
    if (!nav) return;
    var btn = nav.querySelector('.toc__toggle');
    var wide = matchMedia('(min-width: 1100px)');
    function key() { return wide.matches ? 'toc-open-wide' : 'toc-open-narrow'; }
    function read() {
      var v = null; try { v = localStorage.getItem(key()); } catch (e) {}
      return v === null ? wide.matches : v === '1';
    }
    function set(open, save) {
      nav.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
      if (save) { try { localStorage.setItem(key(), open ? '1' : '0'); } catch (e) {} }
    }
    set(read(), false);
    btn.addEventListener('click', function () { set(nav.dataset.open !== 'true', true); });
    wide.addEventListener('change', function () { set(read(), false); });
    nav.addEventListener('click', function (e) {
      if (e.target.closest('a') && !wide.matches) set(false, false);
    });
    var links = {};
    nav.querySelectorAll('.toc__list a').forEach(function (a) { links[decodeURIComponent(a.hash.slice(1))] = a; });
    var heads = Object.keys(links).map(function (id) { return document.getElementById(id); }).filter(Boolean);
    // 画面の上から4割の線より上にある最後の見出しを「今読んでいる見出し」にする
    function mark() {
      var cur = null, line = innerHeight * 0.4;
      heads.forEach(function (h) { if (h.getBoundingClientRect().top < line) cur = h; });
      Object.keys(links).forEach(function (id) { links[id].classList.toggle('is-active', !!cur && cur.id === id); });
    }
    var ticking = false;
    addEventListener('scroll', function () { if (ticking) return; ticking = true; requestAnimationFrame(function () { ticking = false; mark(); }); }, { passive: true });
    mark();
  });
</script>
