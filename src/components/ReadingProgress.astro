---
// 記事ページ用の読み進みバー。CSS scroll-driven animations が基本、未対応ブラウザは小さなJSで代替。
// 見た目は html の data-rp で切り替える（空=今の線 / ruler / cat / spiral / arrow / pct / train / rocket / candle / pixel / neon / snake）。
// 紙吹雪は data-rpc=1 で別にオン・オフ（どの見た目とも組み合わせられる）。
// バーは固定ヘッダーのすぐ下（top: var(--hdr)）に出す。高さの目安 --rpb は Base.astro で決める。
// 定規：30cm を画面幅に合わせて描く。mm=短い線、5mm=中くらい、cm=長い線と数字0〜30。線の太さは拡大しても1pxのまま。
const ticks = Array.from({ length: 301 }, (_, i) => `M${i} 0v${i % 10 === 0 ? 11 : i % 5 === 0 ? 7.5 : 4.5}`).join('');
// ヘビ：波の線を横に流して体をうねらせる。1つの波は40px、2600pxあれば広い画面でも足りる。
const wave = 'M0 10q10-6 20 0' + 't20 0'.repeat(129);
const nums = Array.from({ length: 31 }, (_, i) => i);
---
<script is:inline>
  // 描画前に保存済みの見た目を当て、一瞬だけ別の見た目が出るのを防ぐ
  try { document.documentElement.dataset.rp = localStorage.getItem('rp') || '';
    document.documentElement.dataset.rpc = localStorage.getItem('rpc') || '';
    document.documentElement.dataset.rpo = localStorage.getItem('rpo') || ''; } catch (e) {}
</script>
<div class="reading-progress" aria-hidden="true"><div class="reading-progress__bar"><div class="rp-ruler"><svg viewBox="-3 0 306 12" preserveAspectRatio="none"><path d={ticks} /></svg>{nums.map((n) => <i style={`left:${((n * 10 + 3) / 306 * 100).toFixed(3)}%`}>{n}</i>)}</div></div><div class="rp-snake"><svg viewBox="0 0 2600 20"><path id="rp-w" d={wave} /><use class="rp-sn-dot" href="#rp-w" /></svg></div><span class="rp-head"><svg class="rp-cat" viewBox="0 0 26 16"><path class="rp-tail" d="M6 8.5C3.5 8 2.2 6.4 2.6 3.8"/><path class="rp-lg rp-lb1" d="M7.5 10.5 7 14.5"/><path class="rp-lg rp-lf1" d="M15.5 10.5 16 14.5"/><path d="M6 9.5C6 7.2 7.6 6 10 6h5.5c1.4 0 2.2.8 2.4 2v2.4H6.8"/><path class="rp-lg rp-lb2" d="M9.5 10.5 10 14.5"/><path class="rp-lg rp-lf2" d="M13.5 10.5 13 14.5"/><path d="M17.4 7.6c-.6-1.7.2-3.2 1.1-3.6l.4-2.6 1.9 1.9h1.4l1.9-1.9.4 2.6c.9.4 1.4 1.6.9 3-.5 1.5-1.9 2.2-3.8 2.2-1.6 0-3.6-.6-4.2-1.6"/><circle class="rp-eye" cx="22.6" cy="5.9" r=".55"/></svg><svg class="rp-sp" viewBox="0 0 12 12"><path d="M6 6a1 1 0 0 1 2 0 2 2 0 0 1-4 0 3 3 0 0 1 6 0 4 4 0 0 1-8 0"/></svg><svg class="rp-tr" viewBox="0 0 30 14"><path d="M2 10V4h17V2h7v8zM5 6h3v2H5zm6 0h3v2h-3zm11-2h2v3h-2z"/><circle cx="7" cy="11.5" r="1.5"/><circle cx="22" cy="11.5" r="1.5"/></svg><svg class="rp-rk" viewBox="0 0 34 14"><g class="rp-flg"><path class="rp-fl" d="M11 4.6C7 4.4 3 5.3 0 7c3 1.7 7 2.6 11 2.4z"/><path class="rp-fc" d="M11 5.6C9 5.6 7 6.2 5.6 7 7 7.8 9 8.4 11 8.4z"/></g><path d="M11 4.5h13c3.5 0 6.5 1.2 8.5 2.5-2 1.3-5 2.5-8.5 2.5H11z"/><path d="M14 4.5 11.8 1.5H15.6l2.4 3M14 9.5l-2.2 3h3.8l2.4-3"/><circle cx="24" cy="7" r="1.3"/></svg><svg class="rp-sn" viewBox="0 0 20 14"><path d="M1 7q0-5 8-5 9 0 9 5t-9 5q-8 0-8-5"/><circle cx="13" cy="5" r="1.2"/></svg><svg class="rp-px" viewBox="0 0 8 8"><path d="M3 0h2v2H3zM2 2h4v3H2z"/><path class="rp-f1" d="M1 5h1v3H1zm5 0h1v3H6z"/><path class="rp-f2" d="M3 5h2v3H3z"/></svg></span></div>
<style is:global>
  @property --rp { syntax:'<number>'; inherits:true; initial-value:0; }
  @property --pc { syntax:'<integer>'; inherits:true; initial-value:0; }
  .reading-progress { position:fixed; top:var(--hdr, 0px); left:0; right:0; height:4px; z-index:100; pointer-events:none; }
  /* 読み進みバーのオン・オフ（localStorage の rpo。"off"=出さない） */
  [data-rpo=off] .reading-progress { display:none; }
  .reading-progress__bar { height:100%; background:var(--fg); opacity:.75; transform-origin:0 50%; transform:scaleX(var(--rp, 0)); }
  @supports (animation-timeline: scroll()) {
    .reading-progress { animation: rp-grow linear both; animation-duration: auto; animation-timeline: scroll(root block); }
    @keyframes rp-grow { from { --rp:0; --pc:0; } to { --rp:1; --pc:100; } }
  }
  .rp-head, .rp-head svg { display:none; }
  /* ここから選べる見た目。色は今の線と同じ1色 */
  /* 定規：本物の30cm定規のように、地の色の板に目盛りと数字。読むほど左から見える範囲が伸びる */
  .rp-ruler { display:none; }
  [data-rp=ruler] .reading-progress { height:var(--rpb); }
  [data-rp=ruler] .reading-progress__bar { opacity:1; background:var(--ruler-bg); border-bottom:1px solid var(--fg); transform:none; clip-path:inset(0 calc((1 - var(--rp)) * 100%) 0 0); }
  [data-rp=ruler] .rp-ruler { display:block; position:relative; height:100%; color:var(--fg); }
  /* 記事の .post svg（アイコン用 1.15em）に縮められないよう .reading-progress を前に付けて強くする */
  .reading-progress .rp-ruler svg { display:block; width:100%; height:12px; }
  .rp-ruler path { stroke:currentColor; stroke-width:1px; vector-effect:non-scaling-stroke; }
  .rp-ruler i { position:absolute; bottom:1px; transform:translateX(-50%); font:normal 10px/1 var(--sans); font-variant-numeric:tabular-nums; }
  @media (max-width:560px) { .reading-progress .rp-ruler svg { height:10px; } .rp-ruler path { stroke-width:.6px; } .rp-ruler i { font-size:8px; letter-spacing:-.04em; } }
  [data-rp=cat] .rp-head, [data-rp=spiral] .rp-head, [data-rp=arrow] .rp-head, [data-rp=pct] .rp-head {
    display:block; position:absolute; top:0; left:calc(var(--rp) * 100%); transform:translateX(-100%); color:var(--fg); opacity:.75; }
  .rp-head svg { fill:none; stroke:currentColor; stroke-width:1.5; vector-effect:non-scaling-stroke; stroke-linecap:round; stroke-linejoin:round; }
  [data-rp=cat] .reading-progress__bar, [data-rp=spiral] .reading-progress__bar, [data-rp=rocket] .reading-progress__bar { opacity:.35; }
  /* 猫：耳としっぽのある横向きの猫。前後の足を交互に振り、しっぽをゆらし、ときどきまばたき */
  [data-rp=cat] .rp-cat { display:block; width:36px; height:22px; margin-top:1px; overflow:visible; animation:rp-walk .5s ease-in-out infinite; }
  .rp-cat .rp-eye { fill:currentColor; stroke:none; transform-box:fill-box; transform-origin:center; animation:rp-blink 4s infinite; }
  .rp-cat .rp-lg { transform-box:fill-box; transform-origin:50% 0; animation:rp-leg .5s ease-in-out infinite alternate; }
  .rp-cat .rp-lb2, .rp-cat .rp-lf2 { animation-direction:alternate-reverse; }
  .rp-cat .rp-lb1, .rp-cat .rp-lf2 { opacity:.55; } /* 奥の足は薄く */
  .rp-cat .rp-tail { transform-box:fill-box; transform-origin:100% 100%; animation:rp-tail 1.2s ease-in-out infinite alternate; }
  @keyframes rp-walk { 50% { transform:translateY(-.6px); } }
  @keyframes rp-leg { from { transform:rotate(-22deg); } to { transform:rotate(22deg); } }
  @keyframes rp-tail { from { transform:rotate(-10deg); } to { transform:rotate(14deg); } }
  @keyframes rp-blink { 0%, 94%, 100% { transform:none; } 97% { transform:scaleY(.1); } }
  [data-rp=spiral] .rp-sp { display:block; width:20px; height:20px; margin-top:-8px; transform-origin:50% 50%; transform:rotate(calc(var(--rp) * 30turn)); }
  [data-rp=arrow] .rp-head { width:0; height:0; margin-top:-4px; border:6px solid transparent; border-left:10px solid currentColor; border-radius:2px; transform:translateX(-2px); }
  [data-rp=pct] .reading-progress__bar { opacity:.25; }
  [data-rp=pct] .rp-head { position:fixed; left:auto; top:auto; right:16px; bottom:calc(var(--ftr, 0px) + env(safe-area-inset-bottom, 0px) + 12px); /* 固定フッターの上に出す */ transform:none; font-size:.75rem; color:var(--muted); font-variant-numeric:tabular-nums; counter-reset:p var(--pc); }
  [data-rp=pct] .rp-head::after { content:counter(p) "%"; }
  /* 追加の見た目。動きは選ばれたときだけ付く */
  [data-rp=train] .rp-head, [data-rp=rocket] .rp-head, [data-rp=pixel] .rp-head, [data-rp=candle] .rp-head {
    display:block; position:absolute; top:0; left:calc(var(--rp) * 100%); transform:translateX(-100%); color:var(--fg); opacity:.8; }
  /* 電車：20%ごとの駅と右端の終点 */
  [data-rp=train] .reading-progress { height:10px; background:repeating-linear-gradient(90deg,var(--muted) 0 2px,transparent 0 20%); }
  [data-rp=train] .reading-progress::after { content:''; position:absolute; right:0; top:0; width:5px; height:16px; background:var(--fg); }
  [data-rp=train] .reading-progress__bar { height:4px; }
  [data-rp=train] .rp-tr { display:block; width:38px; height:18px; margin-top:5px; animation:rp-walk .3s steps(2) infinite; }
  /* ロケット：後ろから火が出る。速くスクロールするほど火が長くなる（--rv は下のJSで 0〜1） */
  [data-rp=rocket] .rp-rk { display:block; width:46px; height:19px; margin-top:-7px; overflow:visible; }
  .rp-rk .rp-flg { transform-origin:11px 7px; transform:scaleX(calc(.55 + var(--rv, 0) * 1.6)); transition:transform .12s linear; }
  .rp-rk .rp-fl { fill:currentColor; fill-opacity:.35; stroke:none; transform-origin:11px 7px; animation:rp-fire .12s ease-in-out infinite alternate; }
  .rp-rk .rp-fc { fill:currentColor; fill-opacity:.8; stroke:none; transform-origin:11px 7px; animation:rp-fire .09s ease-in-out infinite alternate-reverse; }
  .rp-rk circle { fill:var(--bg); }
  @keyframes rp-fire { to { transform:scale(.82,.9); } }
  /* ドット絵：足を2コマで動かし、ときどき跳ぶ */
  [data-rp=pixel] .rp-px { display:block; width:20px; height:20px; margin-top:3px; fill:currentColor; stroke:none; shape-rendering:crispEdges; animation:rp-jump 1.6s steps(8) infinite; }
  [data-rp=pixel] .rp-f2 { animation:rp-step .3s steps(1) infinite; }
  [data-rp=pixel] .rp-f1 { animation:rp-step .3s steps(1) infinite reverse; }
  @keyframes rp-step { 50% { opacity:0; } }
  @keyframes rp-jump { 75% { transform:none; } 85% { transform:translateY(-6px); } }
  /* ろうそく：左下に立ち、読むほど短くなる */
  [data-rp=candle] .rp-head { position:fixed; top:auto; left:16px; bottom:calc(var(--ftr, 0px) + env(safe-area-inset-bottom, 0px) + 12px); /* 固定フッターの上に出す */ transform:none; width:8px; height:calc(4px + (1 - var(--rp)) * 44px); border:1.2px solid; border-radius:1px; }
  [data-rp=candle] .rp-head::before { content:''; position:absolute; left:0; bottom:100%; width:6px; height:10px; margin-bottom:2px; background:currentColor; border-radius:50% 50% 50% 50%/60% 60% 40% 40%; transform-origin:50% 100%; animation:rp-flick .4s infinite alternate; }
  @keyframes rp-flick { to { transform:scale(.8,1.1); } }
  /* ネオン：配色のリンク色で光る線。速くスクロールすると光が強まる */
  [data-rp=neon] .reading-progress__bar { height:4px; opacity:1; color:var(--link); background:currentColor; border-radius:0 2px 2px 0; box-shadow:0 0 calc(4px + var(--rv, 0) * 8px) calc(var(--rv, 0) * 2px) currentColor; transition:box-shadow .2s; }
  /* ヘビ：読むほど体が右へ伸び、波が流れてうねる。体は文字色、模様はリンク色（配色に合わせる） */
  .rp-snake { display:none; }
  [data-rp=snake] .reading-progress { height:var(--rpb); }
  [data-rp=snake] .reading-progress__bar { display:none; }
  [data-rp=snake] .rp-snake { display:block; position:absolute; inset:0 auto 0 0; width:calc(var(--rp) * 100% - 14px); overflow:hidden; }
  .reading-progress .rp-snake svg { position:absolute; top:50%; left:0; width:2600px; height:20px; margin-top:-10px; fill:none; stroke:var(--sn); stroke-width:6; stroke-linecap:round; animation:rp-slither .8s linear infinite; }
  .rp-snake .rp-sn-dot { stroke:var(--sn2); stroke-width:2; stroke-dasharray:4 8; }
  @keyframes rp-slither { to { transform:translateX(-40px); } }
  [data-rp=snake] .rp-head { display:block; position:absolute; top:50%; left:calc(var(--rp) * 100%); transform:translate(-100%,-50%); }
  [data-rp=snake] .rp-sn { display:block; width:22px; height:16px; fill:var(--sn); stroke:none; animation:rp-walk .8s ease-in-out infinite; }
  [data-rp=snake] .rp-sn circle { fill:var(--sn2); }
  .reading-progress { --sn:color-mix(in srgb, var(--fg) 72%, var(--bg)); --sn2:var(--link); } /* 配色の文字色とリンク色から作る */
  /* 小さい画面でも形が分かるよう、絵は少しだけ大きめの線にする */
  /* 絵はバーの帯（--rpb）の中に収め、本文の1行目にかからないようにする。スマホは帯が20pxなので一回り小さく */
  @media (max-width:560px) { .rp-head svg { stroke-width:1.7; }
    [data-rp=cat] .rp-cat { width:30px; height:18px; } [data-rp=train] .rp-tr { width:32px; height:15px; margin-top:4px; }
    [data-rp=pixel] .rp-px { width:16px; height:16px; } [data-rp=rocket] .rp-rk { width:40px; height:16px; margin-top:-6px; } }
  /* ずっと動く絵は、スクロールしている間（data-rpm=1）だけ動かす。止まっている間は一時停止 */
  .rp-head, .rp-head *, .rp-head::before, .reading-progress__bar, .reading-progress .rp-snake svg { animation-play-state:paused !important; }
  [data-rpm='1'] :is(.rp-head, .rp-head *, .rp-head::before, .reading-progress__bar, .rp-snake svg) { animation-play-state:running !important; }
  /* 紙吹雪 */
  .rp-cf { position:fixed; top:calc(var(--hdr, 0px) - 12px); width:6px; height:10px; z-index:101; pointer-events:none; animation:rp-fall 2.6s ease-in forwards; }
  @keyframes rp-fall { to { transform:translate(var(--dx),105vh) rotate(720deg); } }
  @media (prefers-reduced-motion: reduce) {
    .reading-progress__bar { transition:none; }
    .rp-cat { animation:none !important; }
    .rp-sp { transform:none !important; }
    /* 新しい見た目と紙吹雪は止まった絵にする */
    .rp-head, .rp-head *, .rp-head::before, .reading-progress__bar, .rp-cf, .reading-progress .rp-snake svg { animation:none !important; }
    .rp-cf { top:var(--hdr, 0px); transform:translateY(var(--y)); }
    .rp-cat *, .rp-rk * { animation:none !important; transform:none !important; }
    .rp-rk .rp-flg { transform:scaleX(.55) !important; transition:none; }
  }
</style>
<script is:inline>
  (function () {
    if (window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()')) return;
    var bar = document.querySelector('.reading-progress');
    if (!bar) return;
    var queued = false;
    function update() {
      queued = false;
      var el = document.documentElement;
      var max = el.scrollHeight - el.clientHeight;
      var p = max > 0 ? Math.min(1, Math.max(0, el.scrollTop / max)) : 0;
      bar.style.setProperty('--rp', p);
      bar.style.setProperty('--pc', Math.round(p * 100));
    }
    function onScroll() { if (!queued) { queued = true; requestAnimationFrame(update); } }
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  })();
</script>
<script is:inline>
  // スクロールの速さを --rv（0〜1）にする。ロケットの火とネオンの光に使う。スクロール中は data-rpm=1。動きを減らす設定では何もしない
  (function () {
    var bar = document.querySelector('.reading-progress');
    if (!bar || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var y = scrollY, t = performance.now(), v = 0, running = false;
    function tick(now) {
      var dy = Math.abs(scrollY - y), dt = Math.max(16, now - t);
      y = scrollY; t = now;
      v = Math.max(v * 0.9, Math.min(1, dy / dt / 3));
      bar.style.setProperty('--rv', v.toFixed(3));
      if (v > 0.01) requestAnimationFrame(tick); else { running = false; bar.style.setProperty('--rv', 0); }
    }
    var d = document.documentElement, stop;
    addEventListener('scroll', function () {
      d.dataset.rpm = '1'; clearTimeout(stop);
      stop = setTimeout(function () { d.dataset.rpm = ''; }, 700);
      if (running) return;
      running = true; t = performance.now(); requestAnimationFrame(tick);
    }, { passive: true });
  })();
</script>
<script is:inline>
  // 紙吹雪：オンのときだけ、最後まで読んだら一度だけ舞う
  (function () {
    var d = document.documentElement, done = false;
    function check() {
      if (done || d.dataset.rpc !== '1') return;
      if (d.scrollTop + d.clientHeight < d.scrollHeight - 4) return;
      done = true;
      var c = ['#e4572e', '#29a3a3', '#f3a712', '#4caf50', '#3d7fd9'];
      for (var i = 0; i < 40; i++) {
        var e = document.createElement('i');
        e.className = 'rp-cf';
        e.style.cssText = 'left:' + Math.random() * 100 + 'vw;background:' + c[i % 5] + ';--dx:' + (Math.random() * 120 - 60) + 'px;--y:' + Math.random() * 90 + 'vh;animation-delay:' + Math.random() * .6 + 's';
        document.body.appendChild(e);
        setTimeout(e.remove.bind(e), 3500);
      }
    }
    addEventListener('scroll', check, { passive: true });
    addEventListener('rp-cf', function () { done = false; check(); });
  })();
</script>
