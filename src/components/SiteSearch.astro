---
// 記事検索。固定フッターのアイコンの並び（設定ボタンの隣）に置き、押すとフッターの上に検索欄が開く。
// / または ⌘K（Windows などでは Ctrl+K）でどのページからでも開ける。入力欄に打っている最中は開かない。Esc で閉じる。
// 検索は Pagefind（ビルド時に dist/pagefind に作る索引）。見た目はサイトの色の変数だけを使い、Pagefind の既定UIは使わない
---
<div class="site-search">
  <button class="ss-open ft-icon" type="button" aria-expanded="false" aria-controls="ss-panel" aria-label="記事を検索" aria-keyshortcuts="/ Meta+K Control+K" title="検索（/ または ⌘K・Ctrl+K）"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg></button>
  <div class="ss-panel" id="ss-panel" role="dialog" aria-label="記事を検索" hidden>
    <input class="ss-input" type="search" placeholder="記事を検索（例: 品詞）" aria-label="記事を検索" autocomplete="off" />
    <p class="ss-hint">/ または ⌘K（Ctrl+K）で開く・Esc で閉じる</p>
    <p class="ss-status" aria-live="polite"></p>
    <ul class="ss-results"></ul>
  </div>
</div>
<style>
  .site-search { flex:none; display:flex; }
  .ss-open { padding:0; font:inherit; background:none; border:0; cursor:pointer; white-space:normal; }
  .ss-open:hover, .ss-open[aria-expanded="true"] { color:var(--fg); }
  .ss-open:focus-visible { outline:2px solid var(--link); outline-offset:-4px; border-radius:4px; }
  .ss-open svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; }
  @media (max-width:560px) { .ss-open svg { width:16px; height:16px; } }
  /* フッターのすぐ上に、本文と同じ幅で開く。長いときは中でスクロール */
  .ss-panel { position:fixed; left:50%; transform:translateX(-50%); bottom:calc(var(--ftr) + env(safe-area-inset-bottom, 0px) + 8px); z-index:101;
    width:min(640px, calc(100vw - 24px)); max-height:calc(100dvh - var(--hdr, 0px) - var(--ftr, 0px) - env(safe-area-inset-bottom, 0px) - 24px); overflow-y:auto; overscroll-behavior:contain;
    padding:12px; background:var(--bg); border:1px solid var(--line); border-radius:4px; color:var(--fg); font-size:1rem; line-height:1.6; white-space:normal; text-align:left; }
  .ss-panel:not([hidden]) { animation:ss-in .15s ease-out; }
  @keyframes ss-in { from { opacity:0; transform:translate(-50%, 4px); } }
  @media (prefers-reduced-motion: reduce) { .ss-panel:not([hidden]) { animation:none; } }
  .ss-input { width:100%; min-height:44px; padding:0 .8em; font:inherit; font-size:16px; color:var(--fg); background:var(--bg); border:1px solid var(--line); border-radius:4px; box-sizing:border-box; }
  .ss-input:focus { outline:2px solid var(--link); outline-offset:1px; }
  .ss-hint { margin:.5em 0 0; color:var(--muted); font-size:.75rem; }
  .ss-status { margin:.6em 0 0; color:var(--muted); font-size:.85rem; }
  .ss-status:empty { display:none; }
  .ss-results { list-style:none; margin:.4em 0 0; padding:0; }
  /* 結果は script で差し込むので :global で当てる */
  .ss-results :global(li) { padding:.6em 0; border-bottom:1px solid var(--line); }
  .ss-results :global(a) { display:block; min-height:44px; overflow-wrap:anywhere; }
  .ss-results :global(p) { margin:.2em 0 0; color:var(--muted); font-size:.85rem; line-height:1.7; overflow-wrap:anywhere; }
  .ss-results :global(mark) { background:none; color:var(--fg); font-weight:600; }
</style>
<script>
// Pagefind は最初に検索欄を開いたときに読み込む（一覧の表示を遅くしない）。dev では索引がないので案内を出す
type Hit = { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> };
type PF = { search: (q: string) => Promise<{ results: Hit[] } | null> };
const root = document.querySelector('.site-search');
const open = root?.querySelector<HTMLButtonElement>('.ss-open');
const panel = root?.querySelector<HTMLDivElement>('.ss-panel');
const input = root?.querySelector<HTMLInputElement>('.ss-input');
const status = root?.querySelector<HTMLParagraphElement>('.ss-status');
const list = root?.querySelector<HTMLUListElement>('.ss-results');
let pf: Promise<PF> | undefined;
const load = () => (pf ??= import(/* @vite-ignore */ `${'/pagefind/'}pagefind.js`) as Promise<PF>);
// 抜粋は Pagefind が本文を HTML エスケープした上で <mark> だけ付けて返すので、そのまま差し込める
const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
let seq = 0;
const run = async () => {
  const q = input!.value.trim();
  const my = ++seq;
  if (!q) { list!.innerHTML = ''; status!.textContent = ''; return; }
  try {
    const r = await (await load()).search(q);
    if (!r || my !== seq) return;
    const hits = await Promise.all(r.results.slice(0, 10).map((h) => h.data()));
    if (my !== seq) return;
    status!.textContent = hits.length ? `${r.results.length}件` : '見つかりませんでした';
    list!.innerHTML = hits.map((h) => `<li><a href="${esc(h.url)}">${esc(h.meta.title ?? h.url)}</a><p>${h.excerpt}</p></li>`).join('');
  } catch {
    status!.textContent = '検索を読み込めませんでした（pnpm run build のあとの表示で使えます）';
  }
};
const setOpen = (on: boolean) => {
  panel!.hidden = !on;
  open!.setAttribute('aria-expanded', String(on));
  if (on) { input!.focus(); input!.select(); load().catch(() => {}); }
};
open?.addEventListener('click', () => setOpen(panel!.hidden));
// 入力欄・選択・編集できる場所で打っているときはショートカットを無視する
const typing = (el: EventTarget | null) => el instanceof HTMLElement && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName));
document.addEventListener('keydown', (e) => {
  if (e.isComposing) return;
  if (e.key === 'Escape' && !panel!.hidden) { setOpen(false); open!.focus(); return; }
  if (typing(e.target)) return;
  const k = e.key.toLowerCase();
  if ((e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) || (k === 'k' && (e.metaKey || e.ctrlKey) && !e.altKey)) { e.preventDefault(); setOpen(true); }
});
// パネルの外を押したら閉じる
document.addEventListener('click', (e) => { if (!panel!.hidden && !root!.contains(e.target as Node)) setOpen(false); });
let t: number | undefined;
input?.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(run, 150); });
</script>
