---
// 背景「雲」。丸いふくらみをつないだ雲の輪郭が細い線で描かれ、ゆっくり右へ流れて止まる。
---
<script is:inline>
(window.BG = window.BG || {}).cloud = function (c) {
  var cl = [], n = c.small ? 3 : 5, i; // スマホは雲を減らす
  for (i = 0; i < n; i++) {
    var w = (c.small ? 90 : 130) + c.rnd() * 90, bumps = [], k, m = 3 + Math.floor(c.rnd() * 2);
    for (k = 0; k < m; k++) bumps.push(w / m * (0.55 + c.rnd() * 0.5));
    cl.push({ x: c.rnd() * c.W - w / 2, y: c.H * (0.12 + c.rnd() * 0.5), w: w, b: bumps, v: 3 + c.rnd() * 4 });
  }
  return { dur: 16000, draw: function (e) {
    var g = c.ctx, p = Math.min(1, e / 5000); g.strokeStyle = c.line; g.lineWidth = 1;
    cl.forEach(function (o, j) {
      var x = o.x + e / 1000 * o.v, y = o.y, seg = o.w / o.b.length;
      g.beginPath(); g.moveTo(x, y);
      // 上のふくらみ（半円）を左から順に描き、底は平らな線で閉じる
      o.b.forEach(function (r, k) { g.arc(x + seg * (k + 0.5), y, Math.max(seg / 2, r / 2), Math.PI, 0); });
      g.lineTo(x, y);
      var len = o.w * 3; g.setLineDash([len, len]); g.lineDashOffset = len * (1 - Math.max(0, Math.min(1, p * 1.4 - j * 0.1))); // 輪郭を少しずつ描く
      g.globalAlpha = 0.6 + (j % 2) * 0.4; g.stroke();
    });
    g.setLineDash([]); g.globalAlpha = 1;
  } };
};
</script>
