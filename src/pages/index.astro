---
import Base from '../layouts/Base.astro';
import SiteSearch from '../components/SiteSearch.astro';
import HomeSettings from '../components/HomeSettings.astro';
import PostList from '../components/PostList.astro';
import { publishedPosts, usedThemes } from '../lib/posts';
const posts = await publishedPosts();
---
<Base>
  <h2 class="list-heading">記事</h2>
  <SiteSearch />
  <PostList posts={posts} themes={usedThemes(posts)} />
  <HomeSettings />
</Base>
