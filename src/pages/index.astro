---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { publishedPosts, usedThemes } from '../lib/posts';
const posts = await publishedPosts();
---
<Base>
  <h2 class="list-heading">記事</h2>
  <PostList posts={posts} themes={usedThemes(posts)} />
</Base>
