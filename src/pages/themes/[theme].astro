---
// テーマごとの記事一覧（/themes/<テーマ>/）
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts, usedThemes } from '../../lib/posts';
import { themeLabel } from '../../lib/themes';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return usedThemes(posts).map((theme) => ({ params: { theme }, props: { theme } }));
}
const { theme } = Astro.props;
const all = await publishedPosts();
const posts = all.filter((p) => p.data.theme === theme);
---
<Base title={themeLabel(theme)}>
  <h2 class="list-heading">{themeLabel(theme)} の記事</h2>
  <PostList posts={posts} themes={usedThemes(all)} current={theme} />
</Base>
