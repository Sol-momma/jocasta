---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ReadingProgressPicker from '../../components/ReadingProgressPicker.astro';
import { getCollection, render } from 'astro:content';
import { editUrl } from '../../lib/github';
import { themeLabel, themeUrl } from '../../lib/themes';
export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
// 日付のあとに並べる補足（空のものは出さない）
const extras = [d.part, d.questionType].filter(Boolean);
---
<Base title={post.data.title} wide>
  <div class="post">
  <ReadingProgress />
  <Toc headings={headings} />
  <p class="meta">{d.date.toISOString().slice(0, 10).replaceAll('-', '.')}{d.theme && <> ・ <a class="theme" href={themeUrl(d.theme)}>{themeLabel(d.theme)}</a></>}{extras.map((x) => <> ・ {x}</>)}{d.sample && <span class="badge">サンプル</span>}</p>
  <h1>{post.data.title}</h1>
  <div class="prose"><Content /></div>
  <p class="back"><a href="/">← 一覧へ</a></p>
  <p class="gh"><a class="gh-link" href={editUrl(post.id)} rel="nofollow">編集</a><ReadingProgressPicker /></p>
  </div>
</Base>
