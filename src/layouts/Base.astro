---
import { newPostUrl } from '../lib/github';
// wide: 記事ページだけ PC 幅（1100px 以上）で画面の横幅いっぱいの組み方にする
const { title, noindex = false, wide = false } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<title>{title ? `${title} | Jocasta` : 'Jocasta — 学習ノート'}</title>
<style is:global>
  /* 参考: borischerny.com の「白に近い地・黒に近い文字・青いリンク・見出しは細め・広めの段落間」。書体は本文も見出しもゴシック */
  :root { --fg:#151515; --muted:#7c7c7c; --line:#e6e6e6; --bg:#fcfcfb; --link:#2463c4; --link-visited:#1c4f9c;
    --sans:"Hiragino Sans","Noto Sans JP","Noto Sans CJK JP",system-ui,sans-serif; --gap:28px;
    /* 固定ヘッダーの高さ(--hdr)と読み進みバーの帯(--rpb)。スマホでは合計が画面の高さの15%以下になるよう小さめ */
    --hdr:76px; --rpb:24px; }
  @media (max-width:560px) { :root { --hdr:56px; --rpb:20px; } }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--fg);
    font-family:var(--sans); line-height:1.6; font-size:16px; -webkit-font-smoothing:antialiased; font-kerning:normal; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  /* ヘッダーはスクロールしても上に固定。地の色で塗り、下の本文が透けないようにする */
  header { position:sticky; top:0; z-index:99; height:var(--hdr); display:flex; align-items:center; background:var(--bg); border-bottom:1px solid var(--line); }
  header .wrap { width:100%; }
  html { scroll-padding-top:calc(var(--hdr) + var(--rpb) + 16px); }
  header a { color:var(--fg); text-decoration:none; font-weight:400; font-size:1.25rem; letter-spacing:.01em; }
  header p { margin:0; color:var(--muted); font-size:.85rem; line-height:1.4; }
  @media (max-width:560px) { header a { font-size:1.1rem; line-height:1.4; } header p { font-size:.75rem; } }
  main { padding: 40px 0 72px; }
  a { color: var(--link); text-decoration:none; }
  a:visited { color: var(--link-visited); }
  a:hover { color: var(--fg); text-decoration:underline; text-underline-offset:3px; }
  h1, h2, h3 { font-weight:400; }
  h1 { font-size:1.75rem; font-weight:500; line-height:1.4; margin:.1em 0 .4em; }
  h2 { font-size:1.3rem; line-height:1.5; margin:2em 0 .6em; }
  h3 { font-size:1.1rem; margin:1.6em 0 .5em; }
  .prose { font-size:17px; line-height:1.9; text-rendering:optimizeLegibility; }
  .prose p, .prose blockquote, .prose pre { margin:0 0 var(--gap); }
  blockquote { margin:1em 0; padding:0 0 0 1em; border-left:3px solid var(--line); color:#666; }
  code { border:1px solid var(--line); background:none; padding:0 .3em; border-radius:3px; font-size:.88em; }
  .meta { color:var(--muted); font-size:.875rem; letter-spacing:.02em; font-variant-numeric:tabular-nums; margin:0 0 var(--gap); }
  .badge { display:inline-block; color:var(--muted); font-size:.72rem; border:1px solid var(--line); padding:0 .45em; border-radius:3px; margin-left:.5em; }
  footer { padding:24px 0 48px; color:var(--muted); font-size:.8rem; border-top:1px solid var(--line); }
  footer .wrap { padding-top:0; }
  .list-heading { font-size:1.6rem; margin:0 0 var(--gap); }
  ol.posts { list-style:none; padding:0; margin:0; }
  ol.posts li { margin:0 0 var(--gap); }
  ol.posts .meta { margin:0; font-size:.85rem; }
  ol.posts h2 { margin:.1em 0 0; font-size:1.3rem; font-weight:500; line-height:1.45; }
  ol.posts h2 a { display:block; }
  /* テーマ名。一覧と記事に控えめに出す */
  .theme { color:var(--muted); }
  a.theme:visited { color:var(--muted); }
  /* テーマで絞り込むリンクの並び。押せる範囲は44px以上 */
  nav.themes { display:flex; flex-wrap:wrap; gap:0 1.2em; margin:-.6em 0 var(--gap); font-size:.9rem; }
  nav.themes a { display:inline-flex; align-items:center; min-height:44px; }
  nav.themes a[aria-current="page"] { color:var(--fg); text-decoration:underline; text-underline-offset:4px; }
  .back { margin-top:3em; font-size:.85rem; }
  /* GitHub で編集・新規作成するリンク。目立たせず、押せる範囲は44px以上にする */
  .gh-link { display:inline-flex; align-items:center; min-height:44px; min-width:44px; color:var(--muted); font-size:.8rem; }
  p.gh { margin:0; }
  .prose ul, .prose ol { padding-left: 1.4em; margin: .3em 0; }
  .prose ul ul, .prose ul ul ul { list-style: disc; }
  .prose li::marker { color: var(--muted); }
  .prose li { margin: .25em 0; line-height:1.8; }
  .prose li > ul, .prose li > ol { margin-left: .15em; padding-left: 1.1em; border-left: 1px solid var(--line); }
  .prose li.has-children { list-style: none; position: relative; }
  .prose li.has-children > .tog { position:absolute; left:-1.3em; top:.2em; width:1.1em; height:1.1em; border:0; background:none; padding:0; cursor:pointer; color:var(--muted); font-size:.8rem; line-height:1.1em; }
  .prose li.has-children > .tog::before { content:"▾"; }
  .prose li.collapsed > .tog::before { content:"▸"; }
  .prose li.collapsed > ul, .prose li.collapsed > ol { display:none; }
.alert { margin:1.6em 0; padding:.7em 1em; border-left:3px solid #9a6700; background:#fbf8f1; font-size:.92rem; }
  .alert-title { font-weight:600; color:#9a6700; margin:0 0 .2em; }
  .alert p { margin:.2em 0; }
  pre { background:#f6f6f6; padding:.9em 1em; border-radius:4px; overflow-x:auto; font-size:.85rem; line-height:1.6; }
  pre code { background:none; padding:0; }
  .pair { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; }
  .pair > div > .label { color:var(--muted); font-size:.78rem; margin:0 0 .3em; }
  @media (max-width:560px) { .pair { grid-template-columns:1fr; } }
  /* 記事ページの PC 幅（1100px 以上）。参考: maggieappleton.com の「ヘッダーは画面の端から端まで・本文は中央の1列・目次は左の余白」。
     本文は 18px × 756px で1行42字に抑える。1099px 以下（スマホ含む）は上の指定のまま変えない */
  @media (min-width:1100px) {
    .is-wide header .wrap, .is-wide footer .wrap { max-width:none; padding:0 40px; }
    .is-wide main > .wrap { max-width:none; padding:0 40px; }
    .post { display:grid; grid-template-columns:minmax(200px,1fr) minmax(0,756px) minmax(200px,1fr); column-gap:48px; }
    .post > * { grid-column:2; }
    .post h1 { font-size:2.4rem; line-height:1.35; margin:.2em 0 .8em; letter-spacing:.01em; }
    .post .prose { font-size:18px; line-height:2; }
    .post .prose h2 { font-size:1.5rem; margin:2.4em 0 .7em; }
    /* 画像・コード・左右比較は本文より右へ広げ、横幅を活かす */
    .post .prose img, .post .prose pre, .post .prose .pair, .post .prose table { width:calc(100% + min(240px, (100vw - 756px - 176px) / 2 - 48px)); max-width:none; }
  }
</style>
</head>
<body class:list={[{ 'is-wide': wide }]}>
<header><div class="wrap"><a href="/">Jocasta</a><p>いろいろなテーマの学習ノート</p></div></header>
<main><div class="wrap"><slot /></div></main>
<footer><div class="wrap">TOEIC の記事は問題文を掲載せず、自作の似た例文で解説しています。<span class="guide-link"> ・ <a href="/guide/">書き方</a></span><span class="gh"> ・ <a class="gh-link" href={newPostUrl()} rel="nofollow">新しい記事</a></span></div></footer>
<script>
document.querySelectorAll('.prose li').forEach((li) => {
  if (!li.querySelector(':scope > ul, :scope > ol')) return;
  li.classList.add('has-children');
  const b = document.createElement('button');
  b.className = 'tog'; b.type = 'button'; b.setAttribute('aria-label', '折りたたむ'); b.setAttribute('aria-expanded', 'true');
  b.addEventListener('click', () => { const c = li.classList.toggle('collapsed'); b.setAttribute('aria-expanded', String(!c)); });
  li.prepend(b);
});
</script>
</body>
</html>
