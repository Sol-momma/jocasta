---
import { newPostUrl } from '../lib/github';
const { title, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<title>{title ? `${title} | Jocasta` : 'Jocasta — TOEIC 学習ノート'}</title>
<style is:global>
  :root { --fg:#1a1a1a; --muted:#8a8a8a; --line:#ececec; --bg:#fff; --link:#1a1a1a; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--fg);
    font-family: "Hiragino Sans","Noto Sans JP",system-ui,sans-serif; line-height:1.9; font-size:16px; -webkit-font-smoothing:antialiased; }
  .wrap { max-width: 600px; margin: 0 auto; padding: 0 24px; }
  header { padding:56px 0 8px; }
  header a { color:var(--fg); text-decoration:none; font-weight:600; font-size:1rem; }
  header p { margin:0; color:var(--muted); font-size:.85rem; }
  main { padding: 32px 0 80px; }
  a { color: var(--link); text-underline-offset:3px; text-decoration-color:#c8c8c8; }
  a:hover { text-decoration-color: var(--fg); }
  h1 { font-size:1.35rem; line-height:1.5; font-weight:600; margin:.2em 0 1.2em; }
  h2 { font-size:1.02rem; font-weight:600; margin-top:2.4em; }
  blockquote { margin:1em 0; padding:0 0 0 1em; border-left:2px solid var(--line); color:#555; }
  code { background:#f4f4f4; padding:.1em .3em; border-radius:3px; font-size:.92em; }
  .meta { color:var(--muted); font-size:.82rem; letter-spacing:.02em; font-variant-numeric:tabular-nums; }
  .badge { display:inline-block; color:var(--muted); font-size:.72rem; border:1px solid var(--line); padding:0 .45em; border-radius:3px; margin-left:.5em; }
  footer { padding:24px 0 48px; color:var(--muted); font-size:.8rem; }
  ol.posts { list-style:none; padding:0; margin:0; }
  ol.posts li { margin:0 0 3.2em; }
  ol.posts h2 { margin:.15em 0 .4em; font-size:1.05rem; }
  ol.posts h2 a { text-decoration:none; }
  ol.posts p { margin:0 0 .5em; color:#444; }
  .more { font-size:.85rem; color:var(--muted); }
  .back { margin-top:3em; font-size:.85rem; }
  /* GitHub で編集・新規作成するリンク。目立たせず、押せる範囲は44px以上にする */
  .gh-link { display:inline-flex; align-items:center; min-height:44px; min-width:44px; color:var(--muted); font-size:.8rem; }
  p.gh { margin:0; }
  .prose ul, .prose ol { padding-left: 1.4em; margin: .3em 0; }
  .prose ul ul, .prose ul ul ul { list-style: disc; }
  .prose li::marker { color: var(--muted); }
  .prose li { margin: .25em 0; line-height:1.8; }
  .prose li > ul, .prose li > ol { margin-left: .15em; padding-left: 1.1em; border-left: 1px solid var(--line); }
  .prose li.has-children { list-style: none; position: relative; }
  .prose li.has-children > .tog { position:absolute; left:-1.3em; top:.2em; width:1.1em; height:1.1em; border:0; background:none; padding:0; cursor:pointer; color:var(--muted); font-size:.8rem; line-height:1.1em; }
  .prose li.has-children > .tog::before { content:"▾"; }
  .prose li.collapsed > .tog::before { content:"▸"; }
  .prose li.collapsed > ul, .prose li.collapsed > ol { display:none; }
.alert { margin:1.6em 0; padding:.7em 1em; border-left:3px solid #9a6700; background:#fbf8f1; font-size:.92rem; }
  .alert-title { font-weight:600; color:#9a6700; margin:0 0 .2em; }
  .alert p { margin:.2em 0; }
  pre { background:#f6f6f6; padding:.9em 1em; border-radius:4px; overflow-x:auto; font-size:.85rem; line-height:1.6; }
  pre code { background:none; padding:0; }
  .pair { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; }
  .pair > div > .label { color:var(--muted); font-size:.78rem; margin:0 0 .3em; }
  @media (max-width:560px) { .pair { grid-template-columns:1fr; } }
</style>
</head>
<body>
<header><div class="wrap"><a href="/">Jocasta</a><p>TOEIC の間違いを記録する学習ノート</p></div></header>
<main><div class="wrap"><slot /></div></main>
<footer><div class="wrap">問題文は掲載せず、自作の似た例文で解説しています。<span class="guide-link"> ・ <a href="/guide/">書き方</a></span><span class="gh"> ・ <a class="gh-link" href={newPostUrl()} rel="nofollow">新しい記事</a></span></div></footer>
<script>
document.querySelectorAll('.prose li').forEach((li) => {
  if (!li.querySelector(':scope > ul, :scope > ol')) return;
  li.classList.add('has-children');
  const b = document.createElement('button');
  b.className = 'tog'; b.type = 'button'; b.setAttribute('aria-label', '折りたたむ'); b.setAttribute('aria-expanded', 'true');
  b.addEventListener('click', () => { const c = li.classList.toggle('collapsed'); b.setAttribute('aria-expanded', String(!c)); });
  li.prepend(b);
});
</script>
</body>
</html>
